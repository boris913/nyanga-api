NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nyanga:nyanga@localhost:5432/nyanga

# URL publique du site (Vercel), utilisée pour CORS et les redirections Chariow
WEB_URL=http://localhost:3000

# Secrets : au moins 32 caractères aléatoires (openssl rand -hex 32)
JWT_SECRET=change-me-change-me-change-me-change-me

# Emails (réinitialisation du mot de passe) : "none" désactive la fonction (MVP),
# "console" affiche les emails dans les logs (dev uniquement)
MAIL_DRIVER=none
MAIL_FROM=Nyanga <no-reply@nyanga.cm>

# Connexion Google : identifiant client OAuth "Application Web" (Google Cloud Console)
GOOGLE_CLIENT_ID=

# Stockage des photos, compatible S3 (AWS S3 ou Cloudflare R2)
S3_BUCKET=nyanga-media
S3_REGION=eu-west-3
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=https://nyanga-media.s3.eu-west-3.amazonaws.com

# Chariow (voir docs/CHARIOW.md)
CHARIOW_API_KEY=
CHARIOW_PULSE_SECRET=
CHARIOW_PRODUCT_PREMIUM=
CHARIOW_PRODUCT_VIP=
CHARIOW_PRODUCT_BUMP=
CHARIOW_PRODUCT_FEATURED_24H=
CHARIOW_PRODUCT_FEATURED_7D=

# Emails promus administrateurs, séparés par des virgules.
# La promotion n'a lieu qu'avec un email prouvé : connexion Google ou réinitialisation du mot de passe.
# Sans ces deux fonctions (MVP), nommer un admin avec : npm run admin:promote -- email@exemple.cm
ADMIN_EMAILS=
